@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card">
    <div class="empty-state">
        <span class="stat-icon tone-danger"><i class="bi bi-exclamation-octagon"></i></span>
        <h3>Something went wrong</h3>
        <p>An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
    </div>
</div>
