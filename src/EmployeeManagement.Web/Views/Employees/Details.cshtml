@model Employee
@{
    ViewData["Title"] = Model.FullName;
    var tenure = DateTime.Today - Model.HireDate;
    var years = (int)(tenure.TotalDays / 365.25);
    var months = (int)(tenure.TotalDays % 365.25 / 30.44);
    var tenureText = tenure.TotalDays < 0 ? "Starts soon"
        : years > 0 ? $"{years} yr {months} mo"
        : $"{months} mo";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
        <h1 class="page-title">Employee profile</h1>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-action="Delete" asp-route-id="@Model.EmployeeId"><i class="bi bi-trash text-danger"></i> Delete</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.EmployeeId"><i class="bi bi-pencil"></i> Edit</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="profile-header">
            <span class="avatar avatar-lg avatar-@(Model.EmployeeId % 6)">@Model.Initials</span>
            <div class="flex-grow-1">
                <h2 class="profile-name">@Model.FullName</h2>
                <div class="text-muted">@Model.JobTitle · @Model.DepartmentName</div>
            </div>
            <span class="status-badge @(Model.IsActive ? "status-active" : "status-inactive")">@(Model.IsActive ? "Active" : "Inactive")</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Employment details</h3></div>
            <div class="card-body">
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">@Html.DisplayNameFor(m => m.Email)</div>
                        <div class="detail-value"><a href="mailto:@Model.Email">@Model.Email</a></div>
                    </div>
                    <div>
                        <div class="detail-label">@Html.DisplayNameFor(m => m.JobTitle)</div>
                        <div class="detail-value">@Model.JobTitle</div>
                    </div>
                    <div>
                        <div class="detail-label">@Html.DisplayNameFor(m => m.DepartmentName)</div>
                        <div class="detail-value">
                            <a class="dept-badge" asp-action="Index" asp-route-departmentId="@Model.DepartmentId">@Model.DepartmentName</a>
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">@Html.DisplayNameFor(m => m.HireDate)</div>
                        <div class="detail-value">@Model.HireDate.ToString("d MMMM yyyy")</div>
                    </div>
                    <div>
                        <div class="detail-label">Employee ID</div>
                        <div class="detail-value">EMP-@Model.EmployeeId.ToString("D4")</div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-value">@(Model.IsActive ? "Currently employed" : "No longer active")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body stat-card d-flex align-items-center gap-3">
                <span class="stat-icon tone-success"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <div class="stat-label">Annual salary</div>
                    <div class="stat-value">@Model.Salary.ToString("C0")</div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon tone-primary"><i class="bi bi-calendar-check"></i></span>
                <div>
                    <div class="stat-label">Time with company</div>
                    <div class="stat-value">@tenureText</div>
                </div>
            </div>
        </div>
    </div>
</div>
