@model Employee
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@Model.FullName</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.EmployeeId">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.EmployeeId">Delete</a>
    </div>
</div>

<dl class="row form-wide">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.JobTitle)</dt>
    <dd class="col-sm-9">@Model.JobTitle</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DepartmentName)</dt>
    <dd class="col-sm-9">
        <a asp-action="Index" asp-route-departmentId="@Model.DepartmentId">@Model.DepartmentName</a>
    </dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Salary)</dt>
    <dd class="col-sm-9">@Model.Salary.ToString("C")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.HireDate)</dt>
    <dd class="col-sm-9">@Model.HireDate.ToString("d MMMM yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>

<a asp-action="Index">&larr; Back to employees</a>
