@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Edit employee";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Employee.EmployeeId">@Model.Employee.FullName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1 class="page-title">Edit employee</h1>
        <p class="page-subtitle">Update @Model.Employee.FullName's details.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Employee.EmployeeId" method="post" class="card form-card" novalidate>
    <input type="hidden" asp-for="Employee.EmployeeId" />
    <partial name="_Form" model="Model" />
    <div class="form-footer">
        <a asp-action="Details" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
