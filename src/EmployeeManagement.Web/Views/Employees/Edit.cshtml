@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Edit employee";
}

<h1 class="h3 mb-4">Edit @Model.Employee.FullName</h1>

<form asp-action="Edit" asp-route-id="@Model.Employee.EmployeeId" method="post" class="form-wide">
    <input type="hidden" asp-for="Employee.EmployeeId" />
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
