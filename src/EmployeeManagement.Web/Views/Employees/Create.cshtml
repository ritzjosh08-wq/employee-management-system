@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Add employee";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add employee</li>
            </ol>
        </nav>
        <h1 class="page-title">Add employee</h1>
        <p class="page-subtitle">Create a new employee record.</p>
    </div>
</div>

<form asp-action="Create" method="post" class="card form-card" novalidate>
    <partial name="_Form" model="Model" />
    <div class="form-footer">
        <a asp-action="Index" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create employee</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
