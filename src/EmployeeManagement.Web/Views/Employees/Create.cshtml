@model EmployeeFormViewModel
@{
    ViewData["Title"] = "New employee";
}

<h1 class="h3 mb-4">New employee</h1>

<form asp-action="Create" method="post" class="form-wide">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
