@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
    var result = Model.Result;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a class="btn btn-primary" asp-action="Create">New employee</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-5">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search name, email or job title" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select name="departmentId" class="form-select" asp-items="Model.Departments">
            <option value="">All departments</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

@if (result.Items.Count == 0)
{
    <p class="text-muted">No employees match your filters.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Job title</th>
                <th>Department</th>
                <th class="text-end">Salary</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in result.Items)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@e.EmployeeId">@e.FullName</a>
                        <div class="small text-muted">@e.Email</div>
                    </td>
                    <td>@e.JobTitle</td>
                    <td>@e.DepartmentName</td>
                    <td class="text-end">@e.Salary.ToString("C0")</td>
                    <td>
                        @if (e.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@e.EmployeeId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.EmployeeId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            Page @result.Page of @result.TotalPages &middot; @result.TotalCount employee(s)
        </span>
        <nav aria-label="Employee pages">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(result.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-departmentId="@Model.DepartmentId" asp-route-page="@(result.Page - 1)">Previous</a>
                </li>
                <li class="page-item @(result.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-departmentId="@Model.DepartmentId" asp-route-page="@(result.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
