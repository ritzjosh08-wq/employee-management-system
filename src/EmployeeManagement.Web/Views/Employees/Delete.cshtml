@model Employee
@{
    ViewData["Title"] = "Delete employee";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.EmployeeId">@Model.FullName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Delete</li>
            </ol>
        </nav>
        <h1 class="page-title">Delete employee</h1>
    </div>
</div>

<div class="card confirm-card">
    <div class="card-body">
        <span class="stat-icon tone-danger"><i class="bi bi-exclamation-triangle"></i></span>
        <h2 class="h5 fw-semibold">Delete @Model.FullName?</h2>
        <p class="text-muted">This permanently removes their record. This can't be undone.</p>

        <div class="person p-3 rounded-3 border mb-3">
            <span class="avatar avatar-@(Model.EmployeeId % 6)">@Model.Initials</span>
            <div>
                <span class="person-name">@Model.FullName</span>
                <span class="person-meta">@Model.JobTitle · @Model.DepartmentName</span>
            </div>
        </div>

        <div class="alert alert-info d-flex gap-2 small mb-0">
            <i class="bi bi-lightbulb"></i>
            <span>To keep their history, <a asp-action="Edit" asp-route-id="@Model.EmployeeId">edit the employee</a> and switch off "Active" instead.</span>
        </div>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.EmployeeId" method="post" class="form-footer">
        <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete employee</button>
    </form>
</div>
