@model EmployeeFormViewModel
@{
    var currency = System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger mx-3 mt-3 mb-0"></div>

<div class="form-section">
    <div class="form-section-title">Personal details</div>
    <div class="form-section-hint">The employee's name and work email address.</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Employee.FirstName" class="form-label"></label>
            <input asp-for="Employee.FirstName" class="form-control" autocomplete="off" />
            <span asp-validation-for="Employee.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.LastName" class="form-label"></label>
            <input asp-for="Employee.LastName" class="form-control" autocomplete="off" />
            <span asp-validation-for="Employee.LastName" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Employee.Email" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Employee.Email" class="form-control" autocomplete="off" placeholder="name@company.com" />
            </div>
            <span asp-validation-for="Employee.Email" class="text-danger"></span>
            <div class="form-text">Must be unique across all employees.</div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">Job details</div>
    <div class="form-section-hint">Role, team, pay and start date.</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Employee.JobTitle" class="form-label"></label>
            <input asp-for="Employee.JobTitle" class="form-control" placeholder="e.g. Software Engineer" />
            <span asp-validation-for="Employee.JobTitle" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.DepartmentId" class="form-label"></label>
            <select asp-for="Employee.DepartmentId" asp-items="Model.Departments" class="form-select">
                <option value="0">Select a department…</option>
            </select>
            <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.Salary" class="form-label">Annual salary</label>
            <div class="input-group">
                <span class="input-group-text">@currency</span>
                <input asp-for="Employee.Salary" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <span asp-validation-for="Employee.Salary" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Employee.HireDate" class="form-label"></label>
            <input asp-for="Employee.HireDate" class="form-control" />
            <span asp-validation-for="Employee.HireDate" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-check form-switch d-flex align-items-center gap-3 ps-0">
        <input asp-for="Employee.IsActive" class="form-check-input ms-0" role="switch" />
        <div>
            <label asp-for="Employee.IsActive" class="form-check-label fw-semibold">Active employee</label>
            <div class="form-text mt-0">Turn off for people who have left. Their record is kept for reporting.</div>
        </div>
    </div>
</div>
