@model Department
@{
    ViewData["Title"] = "New department";
}

<h1 class="h3 mb-4">New department</h1>

<form asp-action="Create" method="post" class="form-narrow">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
