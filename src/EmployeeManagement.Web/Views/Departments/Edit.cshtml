@model Department
@{
    ViewData["Title"] = "Edit department";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Departments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit @Model.Name</li>
            </ol>
        </nav>
        <h1 class="page-title">Edit department</h1>
        <p class="page-subtitle">Rename the department or change its location.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.DepartmentId" method="post" class="card form-card-narrow" novalidate>
    <input type="hidden" asp-for="DepartmentId" />
    <partial name="_Form" model="Model" />
    <div class="form-footer">
        <a asp-action="Index" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
