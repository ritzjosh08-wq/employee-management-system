@model Department

<div asp-validation-summary="ModelOnly" class="alert alert-danger mx-3 mt-3 mb-0"></div>

<div class="form-section">
    <div class="form-section-title">Department details</div>
    <div class="form-section-hint">The name must be unique. Location is optional.</div>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Engineering" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Location" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                <input asp-for="Location" class="form-control" placeholder="e.g. Building A" autocomplete="off" />
            </div>
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>
</div>
