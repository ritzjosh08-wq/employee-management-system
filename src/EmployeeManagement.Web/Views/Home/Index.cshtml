@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var stats = Model.Stats;
    var inactive = stats.TotalEmployees - stats.ActiveEmployees;
    var activePercent = stats.TotalEmployees == 0 ? 0 : stats.ActiveEmployees * 100 / stats.TotalEmployees;
    var maxHeadcount = Model.Departments.Count == 0 ? 0 : Model.Departments.Max(d => d.EmployeeCount);
    var largest = Model.Departments.OrderByDescending(d => d.EmployeeCount).FirstOrDefault();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">An overview of your workforce on @DateTime.Today.ToString("dddd, d MMMM yyyy").</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-controller="Departments" asp-action="Create"><i class="bi bi-plus-square"></i> Add department</a>
        <a class="btn btn-primary" asp-controller="Employees" asp-action="Create"><i class="bi bi-person-plus"></i> Add employee</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a class="card stat-card h-100 text-reset" asp-controller="Employees" asp-action="Index">
            <div class="card-body">
                <span class="stat-icon tone-primary"><i class="bi bi-people"></i></span>
                <div>
                    <div class="stat-label">Total employees</div>
                    <div class="stat-value">@stats.TotalEmployees</div>
                    <div class="stat-hint">@inactive inactive</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="card stat-card h-100 text-reset" asp-controller="Employees" asp-action="Index" asp-route-isActive="true">
            <div class="card-body">
                <span class="stat-icon tone-success"><i class="bi bi-person-check"></i></span>
                <div>
                    <div class="stat-label">Active employees</div>
                    <div class="stat-value">@stats.ActiveEmployees</div>
                    <div class="stat-hint">@activePercent% of workforce</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="card stat-card h-100 text-reset" asp-controller="Departments" asp-action="Index">
            <div class="card-body">
                <span class="stat-icon tone-warning"><i class="bi bi-diagram-3"></i></span>
                <div>
                    <div class="stat-label">Departments</div>
                    <div class="stat-value">@Model.Departments.Count</div>
                    <div class="stat-hint">@(largest is null ? "None yet" : $"Largest: {largest.Name}")</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="card stat-card h-100 text-reset" asp-controller="Employees" asp-action="Index" asp-route-sort="salary_desc">
            <div class="card-body">
                <span class="stat-icon tone-slate"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <div class="stat-label">Average salary</div>
                    <div class="stat-value">@stats.AverageSalary.ToString("C0")</div>
                    <div class="stat-hint">Across all employees</div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Headcount by department</h2>
                    <div class="stat-hint">Active employees and average salary</div>
                </div>
                <a class="btn btn-sm btn-light" asp-controller="Departments" asp-action="Index">View all</a>
            </div>
            <div class="card-body">
                @if (Model.Departments.Count == 0)
                {
                    <p class="text-muted mb-0">No departments yet.</p>
                }
                @foreach (var d in Model.Departments)
                {
                    var width = maxHeadcount == 0 ? 0 : d.EmployeeCount * 100 / maxHeadcount;
                    <div class="bar-row">
                        <a class="bar-label" asp-controller="Employees" asp-action="Index" asp-route-departmentId="@d.DepartmentId">@d.Name</a>
                        <div class="bar-track" role="img" aria-label="@d.EmployeeCount active employees">
                            <div class="bar-fill" style="width: @width%"></div>
                        </div>
                        <div class="bar-value"><strong>@d.EmployeeCount</strong> · avg @d.AverageSalary.ToString("C0")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">Recent hires</h2>
                <a class="btn btn-sm btn-light" asp-controller="Employees" asp-action="Index" asp-route-sort="hired_desc">View all</a>
            </div>
            @if (Model.RecentHires.Count == 0)
            {
                <div class="card-body text-muted">No active employees yet.</div>
            }
            @foreach (var e in Model.RecentHires)
            {
                <div class="list-row">
                    <div class="person">
                        <span class="avatar avatar-@(e.EmployeeId % 6)">@e.Initials</span>
                        <div class="min-w-0">
                            <a class="person-name" asp-controller="Employees" asp-action="Details" asp-route-id="@e.EmployeeId">@e.FullName</a>
                            <span class="person-meta">@e.JobTitle · @e.DepartmentName</span>
                        </div>
                    </div>
                    <span class="stat-hint text-nowrap">@e.HireDate.ToString("d MMM yyyy")</span>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header"><h2 class="card-title">Quick actions</h2></div>
            <div class="card-body d-grid gap-2">
                <a class="quick-action" asp-controller="Employees" asp-action="Create">
                    <span class="stat-icon tone-primary"><i class="bi bi-person-plus"></i></span>
                    <span><span class="quick-action-title">Add an employee</span><span class="quick-action-sub">Create a new employee record</span></span>
                </a>
                <a class="quick-action" asp-controller="Departments" asp-action="Create">
                    <span class="stat-icon tone-warning"><i class="bi bi-plus-square"></i></span>
                    <span><span class="quick-action-title">Add a department</span><span class="quick-action-sub">Set up a new team or business unit</span></span>
                </a>
                <a class="quick-action" asp-controller="Employees" asp-action="Index" asp-route-isActive="false">
                    <span class="stat-icon tone-slate"><i class="bi bi-person-dash"></i></span>
                    <span><span class="quick-action-title">Review inactive employees</span><span class="quick-action-sub">@inactive record(s) marked inactive</span></span>
                </a>
            </div>
        </div>
    </div>
</div>
