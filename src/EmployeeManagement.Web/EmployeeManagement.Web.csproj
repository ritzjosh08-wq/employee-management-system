<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>employee-management-web-3f9a1c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient depends on an older Pkcs package with known vulnerabilities; pin the patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- The SQL scripts live in /database at the repo root; copy them next to the app so
       DatabaseInitializer can run them on startup. -->
  <ItemGroup>
    <None Include="..\..\database\*.sql" LinkBase="Database" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
